# Optional transaction mail. Server-only; leave unset to keep delivery disabled.
# Copy to ignored .env.local for development, or configure Worker runtime settings.
# Never use NEXT_PUBLIC_ names for these values.
INBOX_URL=
INBOX_SEND_API_KEY=
INBOX_FROM_EMAIL=
INBOX_FROM_NAME=
