# Optional transaction mail. Server-only; leave unset to keep delivery disabled.
# Copy to ignored .env.local for development, or configure Worker runtime settings.
# Never use NEXT_PUBLIC_ names for these values.
INBOX_URL=
INBOX_SEND_API_KEY=
INBOX_FROM_EMAIL=
INBOX_FROM_NAME=
# See docs/ai-font-billing.md for endpoint, sender, limits and rollout instructions.

# Checkout rollout: server runtime settings, never NEXT_PUBLIC_.
# Private is the default; only allowlisted verified login emails can buy a pack.
# Leave the allowlist blank to disable purchases for everyone. Set mode to public only at launch.
AI_FONT_CHECKOUT_MODE=private
AI_FONT_CHECKOUT_ALLOWLIST=
