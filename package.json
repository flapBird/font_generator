{
  "name": "font_generator",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "preview": "npm run build:cloudflare && npm run preview:cloudflare",
    "deploy": "npm run build:cloudflare && npm run deploy:cloudflare",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test:cloudflare": "node --test tests/cloudflare/*.test.mjs",
    "test:cloudflare:browser": "playwright test --config tests/cloudflare/playwright.config.ts",
    "test:generators": "node scripts/check-generators.cjs",
    "test:ai-font": "node --conditions=react-server --import tsx --test tests/ai-font/*.test.ts",
    "test:ai-font:browser": "playwright test --config tests/ai-font/playwright.config.ts"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/berkshire-swash": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/luckiest-guy": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@next/third-parties": "16.3.8",
    "@opennextjs/cloudflare": "^1.20.8",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.5.4",
    "framer-motion": "^12.23.25",
    "next": "16.3.8",
    "postcss": "^8.5.20",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.25.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.147.0"
  }
}
