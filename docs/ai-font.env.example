# Copy these entries into .env.local. Never commit real credentials.
# Existing free tools run without any of these values.
AI_FONT_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MIXFONT_API_KEY=

# Start with Sandbox credentials. Live keys require PAYPAL_ENVIRONMENT=live.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Generate a long random secret. A scheduler must call the reconcile endpoint
# every five minutes using Authorization: Bearer <this secret>.
AI_FONT_CRON_SECRET=
