# Copy these entries into .env.local. Never commit real credentials.
# Existing free tools run without any of these values.
AI_FONT_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MIXFONT_API_KEY=

# Start with Sandbox credentials. Live keys require PAYPAL_ENVIRONMENT=live.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Generate a long random secret. A scheduler must call the reconcile endpoint
# every five minutes using Authorization: Bearer <this secret>.
AI_FONT_CRON_SECRET=

# Choose exactly one checkout provider: waffo or paypal (default).
AI_FONT_PAYMENT_PROVIDER=waffo
# Waffo requires a public HTTPS AI_FONT_APP_URL, including test webhooks.
WAFFO_ENVIRONMENT=test
WAFFO_MERCHANT_ID=
WAFFO_STORE_ID=
WAFFO_PRODUCT_ID=
# PEM strings: quoted multiline values or literal \n separators.
WAFFO_PRIVATE_KEY=
WAFFO_WEBHOOK_PUBLIC_KEY=
